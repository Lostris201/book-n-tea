APP_NAME="Book n Tea"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

LOG_CHANNEL=stack
# security events always go to their own channel (storage/logs/security-*.log, 90 days)
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
# Customer menu base URL used in printed QR codes, e.g. https://menu.example.com
QR_MENU_URL=

# External reservation system. Empty = disabled (panel reservations only). "fake" = demo provider.
# After setting it, an admin must also enable it on /admin/integrations.
RESERVATION_PROVIDER=
RESERVATION_API_BASE_URL=
RESERVATION_API_KEY=
RESERVATION_API_SECRET=
RESERVATION_WEBHOOK_SECRET=
